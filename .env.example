# ── Firebase Config ──────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Firebase project ของคุณ
#
# วิธีหา config:
#   1. ไป https://console.firebase.google.com
#   2. เลือก project → ⚙️ Settings → General
#   3. เลื่อนลงไป "Your apps" → Web app → SDK setup and configuration
#   4. Copy ค่าจาก firebaseConfig {...} มาใส่ที่นี่

REACT_APP_FB_API_KEY=
REACT_APP_FB_AUTH_DOMAIN=
REACT_APP_FB_PROJECT_ID=
REACT_APP_FB_STORAGE_BUCKET=
REACT_APP_FB_MESSAGING_SENDER_ID=
REACT_APP_FB_APP_ID=
REACT_APP_FB_MEASUREMENT_ID=
